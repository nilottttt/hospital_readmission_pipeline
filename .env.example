# ---------------------------------------------------------------
# Copy this file to ".env" and change the values.
#   Windows:  copy .env.example .env
# The .env file is git-ignored - never commit real credentials.
# ---------------------------------------------------------------

# PostgreSQL superuser (used by the postgres container)
POSTGRES_USER=hc_admin
POSTGRES_PASSWORD=change_me_please
POSTGRES_HOST_PORT=5432

# Database that stores the healthcare data (raw/staging/clean/mart/audit)
HC_DB_NAME=healthcare

# Database that Airflow uses for its own metadata
AIRFLOW_DB_NAME=airflow

# Airflow web UI login (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_change_me
AIRFLOW_UID=50000
# Any long random string
AIRFLOW_SECRET_KEY=replace_with_a_long_random_string

# Secret salt used to build patient-safe surrogate keys (hashes).
# Change it once before your first run and then keep it fixed,
# otherwise the surrogate keys change between runs.
HASH_SALT=replace_with_another_long_random_string

# Data source (UCI Diabetes 130-US Hospitals, dataset id 296)
DATA_SOURCE_URL=https://archive.ics.uci.edu/static/public/296/diabetes+130-us+hospitals+for+years+1999-2008.zip
